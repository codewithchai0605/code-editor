{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "code-editor",
    "version": "0.1.0",
    "identifier": "com.vsclone.editor",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../build"
    },
    "app": {
        "windows": [
            {
                "title": "Code Editor",
                "width": 1280,
                "height": 800,
                "minWidth": 640,
                "minHeight": 400,
                "center": true,
                "dragDropEnabled": true
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": {
                    "allow": ["**/*"]
                }
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
